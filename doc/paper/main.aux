\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Aggregate and fine-grained behavior of the fine-tuned EoMT checkpoint. Outlier exposure lowers mean FPR95 for every post-hoc score and improves MaxLogit/RbA mean AuPRC, but the detailed diagnostics show that the gains are dataset-dependent: small RoadObstacle21 objects and Fishyscapes Static boundaries improve, while RoadAnomaly21 boundary behavior regresses.}}{8}{figure.caption.14}\protected@file@percent }
\newlabel{fig:finetuned_analysis}{{6}{8}{Aggregate and fine-grained behavior of the fine-tuned EoMT checkpoint. Outlier exposure lowers mean FPR95 for every post-hoc score and improves MaxLogit/RbA mean AuPRC, but the detailed diagnostics show that the gains are dataset-dependent: small RoadObstacle21 objects and Fishyscapes Static boundaries improve, while RoadAnomaly21 boundary behavior regresses}{figure.caption.14}{}}
\newlabel{fig:finetuned_analysis@cref}{{[figure][6][]6}{[1][7][]8}}
